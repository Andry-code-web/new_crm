                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
                <script>

                  setTimeout(() => {
                    const s = document.getElementById('flash-success');
                    if (s) { s.style.opacity = '0'; setTimeout(() => s.remove(), 300); }
                    const e = document.getElementById('flash-error');
                    if (e) { e.style.opacity = '0'; setTimeout(() => e.remove(), 300); }
                  }, 3500);

                  // ── Modal Pago Normal ──────────────────────────────────────────
                  const modalPago = document.getElementById('modal-pago');
                  const modalPagoContent = modalPago.querySelector('div.bg-white');
                  let currentCuotaId = null;
                  let currentPrestamoId = null;

                  function openModalPago(cuotaId, prestamoId, num, monto) {
                    currentCuotaId = cuotaId;
                    currentPrestamoId = prestamoId;
                    document.getElementById('modal-pago-num').textContent = num;
                    document.getElementById('modal-pago-monto').textContent = monto;
                    document.getElementById('modal-pago-obs').value = '';
                    modalPago.classList.remove('hidden');
                    void modalPago.offsetWidth;
                    modalPago.classList.remove('opacity-0');
                    modalPagoContent.classList.remove('scale-95');
                  }

                  function closeModalPago() {
                    modalPago.classList.add('opacity-0');
                    modalPagoContent.classList.add('scale-95');
                    setTimeout(() => modalPago.classList.add('hidden'), 300);
                  }

                  document.getElementById('btn-cerrar-modal-pago').addEventListener('click', closeModalPago);
                  document.getElementById('btn-cancelar-pago').addEventListener('click', closeModalPago);
                  modalPago.addEventListener('click', (e) => { if (e.target === modalPago) closeModalPago(); });

                  document.querySelectorAll('.btn-registrar-pago').forEach(btn => {
                    btn.addEventListener('click', function () {
                      openModalPago(
                        this.getAttribute('data-cuota-id'),
                        this.getAttribute('data-prestamo-id'),
                        this.getAttribute('data-num'),
                        this.getAttribute('data-monto')
                      );
                    });
                  });

                  document.getElementById('btn-confirmar-pago').addEventListener('click', async function () {
                    if (!currentCuotaId || !currentPrestamoId) return;
                    const obs = document.getElementById('modal-pago-obs').value.trim();
                    const originalHtml = this.innerHTML;
                    try {
                      this.innerHTML = '<svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Registrando...';
                      this.disabled = true;
                      const response = await fetch(`/dashboard/prestamos/${currentPrestamoId}/cuotas/${currentCuotaId}/pagar`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ observacion: obs })
                      });
                      const data = await response.json();
                      if (data.success) {
                        closeModalPago();
                        window.location.href = `/dashboard/prestamos/${currentPrestamoId}/cronograma?success=${encodeURIComponent(data.message)}`;
                      } else {
                        alert('Error: ' + data.message);
                        this.innerHTML = originalHtml;
                        this.disabled = false;
                      }
                    } catch (err) {
                      console.error(err);
                      alert('Error de conexión al servidor.');
                      this.innerHTML = originalHtml;
                      this.disabled = false;
                    }
                  });

                  // ── Cambiar Fecha de Inicio ─────────────────────────────────────
                  const btnCambiarFecha = document.getElementById('btn-cambiar-fecha');
                  const inpFechaInicio = document.getElementById('inp-fecha-inicio');

                  if (inpFechaInicio && btnCambiarFecha) {
                    inpFechaInicio.addEventListener('change', function () {
                      const tieneValor = this.value.trim() !== '';
                      btnCambiarFecha.disabled = !tieneValor;
                      btnCambiarFecha.style.pointerEvents = tieneValor ? '' : 'none';
                      btnCambiarFecha.style.opacity = tieneValor ? '1' : '';
                      btnCambiarFecha.className = [
                        'w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-[10px] text-[13px] font-bold text-white shadow-md transition-all flex-shrink-0',
                        tieneValor
                          ? 'bg-brand-navy hover:bg-brand-navy/90 cursor-pointer'
                          : 'bg-brand-navy/40 cursor-not-allowed opacity-50'
                      ].join(' ');
                    });
                  }

                  if (btnCambiarFecha) {
                    btnCambiarFecha.addEventListener('click', async function () {
                      const fechaInput = inpFechaInicio ? inpFechaInicio.value : '';
                      if (!fechaInput) return;

                      const fechaLegible = new Date(fechaInput + 'T12:00:00').toLocaleDateString('es-MX', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
                      const confirm = await Swal.fire({
                        title: '¿Cambiar fecha de inicio?',
                        html:
                          '<p style="color:#64748B;font-size:14px;margin:0">Se recalcularán <strong>todas las fechas de vencimiento</strong> del cronograma a partir de:</p>' +
                          '<p style="color:#0B162C;font-size:16px;font-weight:700;margin:12px 0 0">' + fechaLegible + '</p>' +
                          '<p style="color:#DC2626;font-size:12px;margin:8px 0 0">⚠ Esta acción no se puede deshacer fácilmente.</p>',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: '<i class="ri-refresh-line"></i> Sí, actualizar fechas',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#0B162C',
                        cancelButtonColor: '#94A3B8',
                        reverseButtons: true
                      });

                      if (!confirm.isConfirmed) return;

                      const resultDiv = document.getElementById('fecha-result');
                      const originalHtml = this.innerHTML;
                      try {
                        this.innerHTML = '<i class="ri-loader-4-line animate-spin text-[15px]"></i> Actualizando...';
                        this.disabled = true;
                        this.style.pointerEvents = 'none';
                        const prestamoId = '<%= prestamo.id %>';
                        const response = await fetch(`/dashboard/prestamos/${prestamoId}/fecha-inicio`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ fecha_inicio: fechaInput })
                        });
                        const data = await response.json();
                        resultDiv.classList.remove('hidden', 'bg-brand-success-light', 'text-brand-success', 'bg-brand-danger-light', 'text-brand-danger');
                        if (data.success) {
                          resultDiv.classList.add('bg-brand-success-light', 'text-brand-success');
                          resultDiv.innerHTML = '<i class="ri-checkbox-circle-line mr-1"></i>' + data.message;
                          await Swal.fire({
                            title: '¡Fechas actualizadas!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'Entendido',
                            confirmButtonColor: '#0B162C',
                            timer: 2500,
                            timerProgressBar: true
                          });
                          window.location.reload();
                        } else {
                          resultDiv.classList.add('bg-brand-danger-light', 'text-brand-danger');
                          resultDiv.innerHTML = '<i class="ri-error-warning-line mr-1"></i>' + data.message;
                          Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0B162C' });
                        }
                      } catch (err) {
                        console.error(err);
                        Swal.fire({ title: 'Error de conexión', text: 'No se pudo comunicar con el servidor.', icon: 'error', confirmButtonColor: '#0B162C' });
                      } finally {
                        this.innerHTML = originalHtml;
                        this.disabled = false;
                        this.style.pointerEvents = '';
                      }
                    });
                  }

                  // ── Amortización y Prorrateo ───────────────────────────────────
                  const modalAmort = document.getElementById('modal-amortizacion');
                  const modalAmortContent = modalAmort ? modalAmort.querySelector('div.bg-white') : null;
                  const btnAbrirAmort = document.getElementById('btn-abrir-amortizacion');
                  const btnCerrarAmort = document.getElementById('btn-cerrar-modal-amort');
                  const btnCancelarAmort = document.getElementById('btn-cancelar-amort');
                  const btnConfirmarAmort = document.getElementById('btn-confirmar-amortizacion');
                  const amortMontoInput = document.getElementById('amort-monto');

                  const prestamoConsts = {
                    id: '<%= prestamo.id %>',
                    saldoCapital: <%= saldoActualCapital %>,
                    cuotaActual: <%= cuotaActualMonto %>,
                      cuotasRestantes: <%= cuotasRestantesCount %>,
                        tasaInteres: <%= prestamo.interes %>,
                          tipoPago: '<%= prestamo.tipo_pago || "mensual" %>',
                            modalidad: '<%= prestamo.modalidad || "frances" %>',
                              moneda: '<%= mon %>'
  };

                  function fmtAmort(n) {
                    return prestamoConsts.moneda + '\u00A0' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  }

                  function openModalAmort() {
                    if (!modalAmort) return;
                    amortMontoInput.value = '';
                    const fechaInput = document.getElementById('amort-fecha');
                    if (fechaInput) fechaInput.value = new Date().toISOString().split('T')[0];
                    document.getElementById('amort-obs').value = '';

                    // Reset selección tipo a cuota
                    document.querySelectorAll('.amort-tipo-card').forEach(c => {
                      c.classList.remove('selected', 'border-brand-blue', 'bg-blue-50/60');
                      c.classList.add('border-brand-border', 'bg-brand-surface');
                    });
                    const firstRadio = document.querySelector('input[name="amort_tipo_reduccion"][value="cuota"]');
                    if (firstRadio) {
                      firstRadio.checked = true;
                      firstRadio.closest('label').querySelector('.amort-tipo-card').classList.add('selected', 'border-brand-blue', 'bg-blue-50/60');
                      firstRadio.closest('label').querySelector('.amort-tipo-card').classList.remove('border-brand-border', 'bg-brand-surface');
                    }

                    calcularPreviewAmort();

                    modalAmort.classList.remove('hidden');
                    void modalAmort.offsetWidth;
                    modalAmort.classList.remove('opacity-0');
                    modalAmortContent.classList.remove('scale-95');
                    setTimeout(() => amortMontoInput.focus(), 150);
                  }

                  function closeModalAmort() {
                    if (!modalAmort) return;
                    modalAmort.classList.add('opacity-0');
                    modalAmortContent.classList.add('scale-95');
                    setTimeout(() => modalAmort.classList.add('hidden'), 300);
                  }

                  if (btnAbrirAmort) btnAbrirAmort.addEventListener('click', openModalAmort);
                  if (btnCerrarAmort) btnCerrarAmort.addEventListener('click', closeModalAmort);
                  if (btnCancelarAmort) btnCancelarAmort.addEventListener('click', closeModalAmort);
                  if (modalAmort) modalAmort.addEventListener('click', (e) => { if (e.target === modalAmort) closeModalAmort(); });

                  // Tipo reduccion toggle
                  document.querySelectorAll('.amort-tipo-option').forEach(label => {
                    label.addEventListener('click', () => {
                      document.querySelectorAll('.amort-tipo-card').forEach(card => {
                        card.classList.remove('selected', 'border-brand-blue', 'bg-blue-50/60');
                        card.classList.add('border-brand-border', 'bg-brand-surface');
                      });
                      const card = label.querySelector('.amort-tipo-card');
                      card.classList.add('selected', 'border-brand-blue', 'bg-blue-50/60');
                      card.classList.remove('border-brand-border', 'bg-brand-surface');
                      calcularPreviewAmort();
                    });
                  });

                  // Atajos de porcentaje
                  document.querySelectorAll('.btn-pct').forEach(btn => {
                    btn.addEventListener('click', function () {
                      const pct = parseFloat(this.getAttribute('data-pct'));
                      const val = (prestamoConsts.saldoCapital * pct).toFixed(2);
                      amortMontoInput.value = val;
                      calcularPreviewAmort();
                    });
                  });

                  if (amortMontoInput) {
                    amortMontoInput.addEventListener('input', calcularPreviewAmort);
                  }

                  function calcularPreviewAmort() {
                    const abono = parseFloat(amortMontoInput.value) || 0;
                    const tipoReduccion = document.querySelector('input[name="amort_tipo_reduccion"]:checked')?.value || 'cuota';
                    let periodosPorAnio = 12;
                    if (prestamoConsts.tipoPago === 'diario') periodosPorAnio = 360;
                    else if (prestamoConsts.tipoPago === 'semanal') periodosPorAnio = 48;
                    else if (prestamoConsts.tipoPago === 'quincenal') periodosPorAnio = 24;
                    const r = (prestamoConsts.tasaInteres / 100) / periodosPorAnio;
                    const S_actual = prestamoConsts.saldoCapital;
                    const N_restante = prestamoConsts.cuotasRestantes;
                    const C_actual = prestamoConsts.cuotaActual;

                    const elNuevoSaldo = document.getElementById('prev-nuevo-saldo');
                    const elMetricLabel = document.getElementById('prev-metric-label');
                    const elMetricVal = document.getElementById('prev-metric-val');
                    const elBeneficio = document.getElementById('prev-beneficio');

                    if (abono <= 0) {
                      elNuevoSaldo.textContent = fmtAmort(S_actual);
                      if (tipoReduccion === 'cuota') {
                        elMetricLabel.textContent = 'Cuota Mensual Actual:';
                        elMetricVal.textContent = fmtAmort(C_actual);
                        elBeneficio.innerHTML = '<i class="ri-information-line"></i> <span>Ingresa un monto para simular la reducción de tu cuota.</span>';
                      } else {
                        elMetricLabel.textContent = 'Cuotas Pendientes:';
                        elMetricVal.textContent = N_restante + ' cuotas';
                        elBeneficio.innerHTML = '<i class="ri-information-line"></i> <span>Ingresa un monto para simular la reducción del plazo.</span>';
                      }
                      return;
                    }

                    // Liquidación total
                    if (abono >= S_actual - 0.05) {
                      elNuevoSaldo.textContent = fmtAmort(0);
                      elMetricLabel.textContent = 'Estado Resultante:';
                      elMetricVal.textContent = 'Liquidación Total';
                      elBeneficio.innerHTML = '<span class="text-green-300 font-bold flex items-center gap-1.5"><i class="ri-checkbox-circle-fill text-[14px]"></i> ¡Préstamo cancelado en su totalidad! Se liquidan todas las cuotas futuras.</span>';
                      return;
                    }

                    const S_nuevo = Math.max(0, S_actual - abono);
                    elNuevoSaldo.textContent = fmtAmort(S_nuevo);

                    if (tipoReduccion === 'cuota') {
                      let cuotaNueva = 0;
                      if (prestamoConsts.modalidad === 'interes_capital') {
                        cuotaNueva = S_nuevo * r;
                      } else if (prestamoConsts.modalidad === 'aleman') {
                        const capFijo = S_nuevo / N_restante;
                        cuotaNueva = capFijo + (S_nuevo * r);
                      } else {
                        // frances
                        if (r === 0) cuotaNueva = S_nuevo / N_restante;
                        else cuotaNueva = S_nuevo * (r * Math.pow(1 + r, N_restante)) / (Math.pow(1 + r, N_restante) - 1);
                      }

                      const ahorroMensual = Math.max(0, C_actual - cuotaNueva);
                      elMetricLabel.textContent = 'Nueva Cuota Mensual:';
                      elMetricVal.textContent = fmtAmort(cuotaNueva);
                      elBeneficio.innerHTML = `<span class="text-green-300 flex items-center gap-1"><i class="ri-arrow-down-circle-line text-[14px]"></i> Tu cuota baja en <strong>${fmtAmort(ahorroMensual)}</strong> al mes, manteniendo las ${N_restante} cuotas restantes.</span>`;

                    } else {
                      // Reducir Plazo
                      let nuevasCuotas = 0;
                      if (prestamoConsts.modalidad === 'interes_capital') {
                        const factor = abono / S_actual;
                        const mesesMenos = Math.max(1, Math.round(N_restante * factor));
                        nuevasCuotas = Math.max(1, N_restante - mesesMenos);
                      } else if (prestamoConsts.modalidad === 'aleman') {
                        const capFijo = S_actual / N_restante;
                        nuevasCuotas = Math.max(1, Math.ceil(S_nuevo / capFijo));
                      } else {
                        // frances
                        let bal = S_nuevo;
                        while (bal > 0.01 && nuevasCuotas < 360) {
                          nuevasCuotas++;
                          let int = bal * r;
                          let cap = Math.min(bal, C_actual - int);
                          if (cap <= 0) cap = bal;
                          bal -= cap;
                        }
                      }

                      const cuotasAhorradas = Math.max(0, N_restante - nuevasCuotas);
                      elMetricLabel.textContent = 'Nuevas Cuotas Restantes:';
                      elMetricVal.textContent = nuevasCuotas + ' cuotas';
                      elBeneficio.innerHTML = `<span class="text-amber-300 flex items-center gap-1"><i class="ri-time-line text-[14px]"></i> Terminas de pagar <strong>${cuotasAhorradas} cuotas antes</strong>, manteniendo tu cuota mensual de ${fmtAmort(C_actual)}.</span>`;
                    }
                  }

                  // Confirmar y Enviar Amortización
                  if (btnConfirmarAmort) {
                    btnConfirmarAmort.addEventListener('click', async function () {
                      const abono = parseFloat(amortMontoInput.value);
                      if (!abono || abono <= 0) {
                        Swal.fire({ title: 'Monto inválido', text: 'Por favor ingresa un monto válido mayor a 0.', icon: 'warning', confirmButtonColor: '#0B162C' });
                        amortMontoInput.focus();
                        return;
                      }

                      if (abono > prestamoConsts.saldoCapital + 0.05) {
                        Swal.fire({ title: 'Monto excede saldo', text: `El monto no puede superar el saldo capital pendiente (${fmtAmort(prestamoConsts.saldoCapital)}).`, icon: 'warning', confirmButtonColor: '#0B162C' });
                        return;
                      }

                      const tipoReduccion = document.querySelector('input[name="amort_tipo_reduccion"]:checked')?.value || 'cuota';
                      const fecha = document.getElementById('amort-fecha').value || new Date().toISOString().split('T')[0];
                      const observacion = document.getElementById('amort-obs').value.trim();

                      const confirm = await Swal.fire({
                        title: '¿Confirmar Amortización a Capital?',
                        html: `
          <div style="text-align:left;font-size:13px;color:#334155;">
            <p style="margin:0 0 8px;">Se aplicará un abono extraordinario directo a capital por:</p>
            <p style="font-size:20px;font-weight:800;color:#0B162C;margin:0 0 12px;">${fmtAmort(abono)}</p>
            <p style="margin:0;"><strong>Modalidad:</strong> ${tipoReduccion === 'cuota' ? 'Reducir valor de cuota (mantener plazo)' : 'Reducir plazo (mantener cuota)'}</p>
            <p style="margin:4px 0 0;"><strong>Fecha:</strong> ${fecha}</p>
          </div>
        `,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '<i class="ri-check-line"></i> Sí, aplicar amortización',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#D4A843',
                        cancelButtonColor: '#94A3B8',
                        reverseButtons: true
                      });

                      if (!confirm.isConfirmed) return;

                      const originalHtml = this.innerHTML;
                      try {
                        this.innerHTML = '<i class="ri-loader-4-line animate-spin text-[16px]"></i> Procesando...';
                        this.disabled = true;

                        const response = await fetch(`/dashboard/prestamos/${prestamoConsts.id}/amortizar`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            monto: abono,
                            tipo_reduccion: tipoReduccion,
                            fecha: fecha,
                            observacion: observacion
                          })
                        });

                        const data = await response.json();
                        if (data.success) {
                          closeModalAmort();
                          await Swal.fire({
                            title: '¡Amortización Aplicada!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'Ver Cronograma Actualizado',
                            confirmButtonColor: '#0B162C'
                          });
                          window.location.reload();
                        } else {
                          Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0B162C' });
                          this.innerHTML = originalHtml;
                          this.disabled = false;
                        }
                      } catch (err) {
                        console.error(err);
                        Swal.fire({ title: 'Error de conexión', text: 'No se pudo comunicar con el servidor.', icon: 'error', confirmButtonColor: '#0B162C' });
                        this.innerHTML = originalHtml;
                        this.disabled = false;
                      }
                    });
                  }

                  // Descargar Simulación en PDF desde el modal
                  const btnSimularPdfAmort = document.getElementById('btn-simular-pdf-amort');
                  if (btnSimularPdfAmort) {
                    btnSimularPdfAmort.addEventListener('click', async function () {
                      const abono = parseFloat(amortMontoInput.value);
                      if (!abono || abono <= 0) {
                        Swal.fire({
                          title: 'Monto requerido',
                          text: 'Por favor ingresa un monto a amortizar para generar la simulación en PDF.',
                          icon: 'warning',
                          confirmButtonColor: '#0B162C'
                        });
                        amortMontoInput.focus();
                        return;
                      }

                      if (abono > prestamoConsts.saldoCapital + 0.05) {
                        Swal.fire({
                          title: 'Monto excede saldo',
                          text: `El monto no puede superar el saldo capital pendiente (${fmtAmort(prestamoConsts.saldoCapital)}).`,
                          icon: 'warning',
                          confirmButtonColor: '#0B162C'
                        });
                        return;
                      }

                      const tipoReduccion = document.querySelector('input[name="amort_tipo_reduccion"]:checked')?.value || 'cuota';
                      const fecha = document.getElementById('amort-fecha').value || new Date().toISOString().split('T')[0];
                      const observacion = document.getElementById('amort-obs').value.trim();

                      const originalHtml = this.innerHTML;
                      try {
                        this.innerHTML = '<i class="ri-loader-4-line animate-spin text-[16px]"></i> Generando PDF...';
                        this.disabled = true;

                        const res = await fetch(`/dashboard/prestamos/${prestamoConsts.id}/amortizacion/simulacion-pdf`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            monto: abono,
                            tipo_reduccion: tipoReduccion,
                            fecha: fecha,
                            observacion: observacion
                          })
                        });

                        if (!res.ok) {
                          const errData = await res.json().catch(() => ({ message: 'Error generando PDF' }));
                          throw new Error(errData.message || 'Error en el servidor al generar PDF');
                        }

                        const blob = await res.blob();
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `simulacion_amortizacion_prestamo_${prestamoConsts.id}.pdf`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        window.URL.revokeObjectURL(url);

                      } catch (err) {
                        console.error(err);
                        Swal.fire({ title: 'Error al generar PDF', text: err.message || 'No se pudo descargar la simulación.', icon: 'error', confirmButtonColor: '#0B162C' });
                      } finally {
                        this.innerHTML = originalHtml;
                        this.disabled = false;
                      }
                    });
                  }

                </script>