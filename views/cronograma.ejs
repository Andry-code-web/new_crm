<% if (user.role==='admin' ) { %>
  <%- include('partials/sidebar_admin') %>
    <% } else if (user.role==='asesor' ) { %>
      <%- include('partials/sidebar_asesor') %>
        <% } else { %>
          <%- include('partials/sidebar_cliente') %>
            <% } %>

              <% const fmt=(n)=> Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2,
                maximumFractionDigits: 2 });
                const fmtDate = (d) => {
                if (!d) return '\u2014';
                const date = new Date(d);
                return date.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
                };
                const progreso = stats.totalCuotas > 0 ? Math.round((stats.cuotasPagadas / stats.totalCuotas) * 100) :
                0;
                const telefonoLimpio = (prestamo.cliente_telefono || '').replace(/[^0-9]/g, '');
                const mon = prestamo.moneda || '$';

                let modLabel = 'Sistema Francés (Cuota Fija)';
                let modBadgeColor = 'bg-brand-blue-light text-brand-blue border-brand-blue/30';
                if (prestamo.modalidad === 'interes_capital') {
                modLabel = 'Interés sobre el Capital (Solo Interés)';
                modBadgeColor = 'bg-brand-gold-light text-brand-gold-hover border-brand-gold/30';
                } else if (prestamo.modalidad === 'aleman') {
                modLabel = 'Amortización Constante (Alemán)';
                modBadgeColor = 'bg-brand-success-light text-brand-success border-brand-success/30';
                }

                const cuotasPagadasList = cuotas.filter(c => c.estado === 'pagada');
                const cuotasPendientesList = cuotas.filter(c => c.estado !== 'pagada');
                let saldoActualCapital = 0;
                if (cuotasPendientesList.length > 0) {
                  const sumCap = cuotasPendientesList.reduce((sum, c) => sum + Number(c.capital || 0), 0);
                  const firstCuotaSaldoIn = Number(cuotasPendientesList[0].saldo || 0) + Number(cuotasPendientesList[0].capital || 0);
                  saldoActualCapital = Math.abs(sumCap - firstCuotaSaldoIn) < 0.1 ? firstCuotaSaldoIn : sumCap;
                }
                const cuotaActualMonto = cuotasPendientesList.length > 0 ? Number(cuotasPendientesList[0].monto_cuota) :
                Number(prestamo.cuota);
                const cuotasRestantesCount = cuotasPendientesList.length;
                %>

                <main class="flex-1 h-screen overflow-y-auto bg-brand-bg relative flex flex-col min-w-0">

                  <!-- Header -->
                  <header
                    class="flex items-center justify-between px-8 py-4 bg-white/92 backdrop-blur-md border-b border-brand-border sticky top-0 z-40">
                    <div class="flex items-center gap-3">
                      <a href="/dashboard/prestamos"
                        class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-brand-surface hover:bg-brand-blue-light hover:text-brand-blue transition-colors text-brand-muted">
                        <i class="ri-arrow-left-s-line text-[18px]"></i>
                      </a>
                      <div>
                        <h1 class="text-[22px] font-bold tracking-tight text-brand-navy">Cronograma de Pagos</h1>
                        <p class="text-[13px] text-brand-muted mt-0.5 flex items-center flex-wrap gap-2">
                          <span>Pr&eacute;stamo #<%= prestamo.id %> &mdash; <strong class="font-bold text-brand-text">
                                <%= prestamo.cliente_nombre %>
                              </strong></span>
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border <%= modBadgeColor %>">
                            <%= modLabel %>
                          </span>
                        </p>
                      </div>
                    </div>
                    <img src="<%= user.avatar %>" alt="Avatar"
                      class="w-[38px] h-[38px] rounded-full border-2 border-brand-gold object-cover">
                  </header>

                  <div class="p-4 max-w-[1400px] mx-auto w-full flex-1 flex flex-col gap-6">

                    <!-- Flash -->
                    <% if (typeof success !=='undefined' && success) { %>
                      <div id="flash-success"
                        class="bg-brand-success-light border border-brand-success text-brand-success px-5 py-4 rounded-[12px] flex flex-col gap-1 transition-opacity duration-300 animate-in">
                        <p class="font-bold text-[14px]">&#161;&#201;xito!</p>
                        <p class="text-[13px] opacity-90">
                          <%= success %>
                        </p>
                      </div>
                      <% } %>
                        <% if (typeof error !=='undefined' && error) { %>
                          <div id="flash-error"
                            class="bg-brand-danger-light border border-brand-danger text-brand-danger px-5 py-4 rounded-[12px] flex flex-col gap-1 transition-opacity duration-300 animate-in">
                            <p class="font-bold text-[14px]">Error</p>
                            <p class="text-[13px] opacity-90">
                              <%= error %>
                            </p>
                          </div>
                          <% } %>

                            <!-- KPI Cards -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 animate-in">
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex items-center gap-4">
                                <div
                                  class="w-11 h-11 rounded-[12px] flex items-center justify-center bg-brand-blue-light text-brand-blue flex-shrink-0">
                                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                  </svg>
                                </div>
                                <div>
                                  <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">Monto
                                    Pr&eacute;stamo</p>
                                  <p class="text-[18px] font-extrabold text-brand-navy mt-0.5">
                                    <%= mon %>&nbsp;<%= fmt(prestamo.monto) %>
                                  </p>
                                </div>
                              </div>
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex items-center gap-4">
                                <div
                                  class="w-11 h-11 rounded-[12px] flex items-center justify-center bg-brand-gold-light text-brand-gold flex-shrink-0">
                                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                  </svg>
                                </div>
                                <div>
                                  <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">Tasa
                                    Inter&eacute;s</p>
                                  <p class="text-[18px] font-extrabold text-brand-navy mt-0.5">
                                    <%= prestamo.interes %>% <span class="text-[12px] text-brand-muted font-normal">(<%=
                                          prestamo.tipo_pago || 'mensual' %>)</span>
                                  </p>
                                </div>
                              </div>
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex items-center gap-4">
                                <div
                                  class="w-11 h-11 rounded-[12px] flex items-center justify-center bg-brand-success-light text-brand-success flex-shrink-0">
                                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                  </svg>
                                </div>
                                <div>
                                  <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">Cuotas
                                    Pagadas</p>
                                  <p class="text-[18px] font-extrabold text-brand-navy mt-0.5">
                                    <%= stats.cuotasPagadas %> / <%= stats.totalCuotas %>
                                  </p>
                                </div>
                              </div>
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex items-center gap-4">
                                <div
                                  class="w-11 h-11 rounded-[12px] flex items-center justify-center bg-brand-navy-light text-brand-navy flex-shrink-0">
                                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                  </svg>
                                </div>
                                <div>
                                  <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">Saldo
                                    Capital Pendiente</p>
                                  <p class="text-[18px] font-extrabold text-brand-navy mt-0.5">
                                    <%= mon %>&nbsp;<%= fmt(saldoActualCapital) %>
                                  </p>
                                </div>
                              </div>
                            </div>

                            <!-- Barra de Progreso -->
                            <div
                              class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border animate-in delay-50">
                              <div class="flex items-center justify-between mb-3">
                                <div>
                                  <p class="text-[14px] font-bold text-brand-navy">Progreso del Pago</p>
                                  <p class="text-[12px] text-brand-muted mt-0.5">
                                    <%= stats.cuotasPagadas %> de <%= stats.totalCuotas %> cuotas completadas
                                  </p>
                                </div>
                                <span class="text-[20px] font-extrabold text-brand-blue">
                                  <%= progreso %>%
                                </span>
                              </div>
                              <div class="w-full bg-brand-surface2 rounded-full h-3 overflow-hidden">
                                <div
                                  class="h-3 rounded-full bg-gradient-to-r from-brand-blue to-brand-success transition-all duration-700"
                                  style="width: <%= progreso %>%"></div>
                              </div>
                              <div class="flex items-center justify-between mt-3 text-[12px] text-brand-muted">
                                <span>Pagado: <strong class="text-brand-success">
                                    <%= mon %>&nbsp;<%= fmt(stats.montoPagado) %>
                                  </strong></span>
                                <span>Total Cuotas Pendientes: <strong class="text-brand-navy">
                                    <%= mon %>&nbsp;<%= fmt(stats.montoPendiente) %>
                                  </strong></span>
                              </div>
                            </div>

                            <!-- Acciones Grid: Amortización y Fechas -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 animate-in delay-75">
                              <!-- Panel Amortización y Prorrateo -->
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col justify-between">
                                <div>
                                  <div class="flex items-center gap-3 mb-2.5">
                                    <div
                                      class="w-9 h-9 rounded-[10px] flex items-center justify-center bg-brand-gold-light text-brand-gold-hover flex-shrink-0">
                                      <i class="ri-funds-box-line text-[19px]"></i>
                                    </div>
                                    <div>
                                      <p class="text-[14px] font-bold text-brand-navy">Amortización Extraordinaria y
                                        Prorrateo</p>
                                      <p class="text-[12px] text-brand-muted">Abona al capital para reducir la cuota
                                        mensual o acortar el plazo.</p>
                                    </div>
                                  </div>
                                  <div
                                    class="grid grid-cols-3 gap-2 my-3 p-3 bg-brand-surface rounded-xl border border-brand-border text-center">
                                    <div>
                                      <p class="text-[10px] uppercase font-bold text-brand-muted">Saldo Capital</p>
                                      <p class="text-[13px] font-extrabold text-brand-navy">
                                        <%= mon %>&nbsp;<%= fmt(saldoActualCapital) %>
                                      </p>
                                    </div>
                                    <div>
                                      <p class="text-[10px] uppercase font-bold text-brand-muted">Cuota Actual</p>
                                      <p class="text-[13px] font-extrabold text-brand-blue">
                                        <%= mon %>&nbsp;<%= fmt(cuotaActualMonto) %>
                                      </p>
                                    </div>
                                    <div>
                                      <p class="text-[10px] uppercase font-bold text-brand-muted">Restantes</p>
                                      <p class="text-[13px] font-extrabold text-brand-warning">
                                        <%= cuotasRestantesCount %> cuotas
                                      </p>
                                    </div>
                                  </div>
                                </div>
                                <div>
                                  <% if (cuotasRestantesCount> 0 && prestamo.estado === 'activo') { %>
                                    <button type="button" id="btn-abrir-amortizacion"
                                      class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-[10px] text-[13px] font-bold text-brand-navy bg-gradient-to-r from-brand-gold to-brand-gold-hover hover:from-brand-gold-hover hover:to-brand-gold shadow-[0_2px_8px_rgba(212,168,67,0.35)] transition-all cursor-pointer">
                                      <i class="ri-calculator-line text-[16px]"></i>
                                      Registrar Amortización a Capital
                                    </button>
                                    <% } else { %>
                                      <button type="button" disabled
                                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-[10px] text-[13px] font-bold text-brand-muted bg-brand-surface2 border border-brand-border opacity-60 cursor-not-allowed">
                                        <i class="ri-check-double-line text-[16px]"></i>
                                        <%= prestamo.estado==='pagado' ? 'Préstamo ya liquidado' : 'Préstamo no activo'
                                          %>
                                      </button>
                                      <% } %>
                                </div>
                              </div>

                              <!-- Panel Cambiar Fecha de Inicio -->
                              <div
                                class="bg-white rounded-[20px] p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col justify-between">
                                <div>
                                  <div class="flex items-center gap-3 mb-2.5">
                                    <div
                                      class="w-9 h-9 rounded-[10px] flex items-center justify-center bg-brand-blue-light text-brand-blue flex-shrink-0">
                                      <i class="ri-calendar-2-line text-[18px]"></i>
                                    </div>
                                    <div>
                                      <p class="text-[14px] font-bold text-brand-navy">Cambiar Fecha de Inicio</p>
                                      <p class="text-[12px] text-brand-muted">Recalcula autom&aacute;ticamente las
                                        fechas de vencimiento.</p>
                                    </div>
                                  </div>
                                  <div class="my-3">
                                    <label
                                      class="block text-[11px] font-semibold text-brand-muted uppercase tracking-wide mb-1.5">Nueva
                                      fecha base</label>
                                    <div class="relative">
                                      <i
                                        class="ri-calendar-line absolute left-3 top-1/2 -translate-y-1/2 text-brand-muted text-[15px] pointer-events-none"></i>
                                      <input type="date" id="inp-fecha-inicio"
                                        value="<%= prestamo.fecha_registro ? new Date(prestamo.fecha_registro).toISOString().split('T')[0] : '' %>"
                                        class="w-full bg-brand-surface border border-brand-border rounded-[10px] py-2.5 pr-3.5 pl-9 text-[13px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                    </div>
                                  </div>
                                </div>
                                <div>
                                  <button type="button" id="btn-cambiar-fecha" disabled
                                    title="Selecciona una fecha para habilitar"
                                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-[10px] text-[13px] font-bold text-white bg-brand-navy/40 shadow-md transition-all flex-shrink-0 cursor-not-allowed opacity-50"
                                    style="pointer-events:none">
                                    <i class="ri-refresh-line text-[15px]"></i>
                                    Actualizar Fechas
                                  </button>
                                  <div id="fecha-result"
                                    class="hidden mt-2 px-3 py-1.5 rounded-[8px] text-[12px] font-medium text-center">
                                  </div>
                                </div>
                              </div>
                            </div>

                            <!-- Tabla de Cuotas -->
                            <div
                              class="bg-white rounded-[20px] shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col overflow-hidden animate-in delay-100">
                              <div
                                class="px-7 py-5 border-b border-brand-border flex items-center justify-between gap-4 flex-wrap">
                                <div>
                                  <p class="text-[16px] font-bold tracking-tight text-brand-navy">Cuotas del
                                    Pr&eacute;stamo</p>
                                  <p class="text-[13px] text-brand-muted mt-0.5">
                                    Cliente: <strong class="text-brand-text">
                                      <%= prestamo.cliente_nombre %>
                                    </strong>
                                    <% if (prestamo.cliente_telefono) { %>
                                      &middot; Tel: <strong class="text-brand-text">
                                        <%= prestamo.cliente_telefono %>
                                      </strong>
                                      <% } %>
                                  </p>
                                </div>
                                <div class="flex items-center gap-2 flex-wrap">
                                  <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-brand-success-light text-brand-success border border-brand-success">
                                    <span class="w-1.5 h-1.5 rounded-full bg-brand-success"></span> Pagada
                                  </span>
                                  <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-amber-50 text-amber-600 border border-amber-300">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pendiente
                                  </span>
                                  <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-brand-danger-light text-brand-danger border border-brand-danger">
                                    <span class="w-1.5 h-1.5 rounded-full bg-brand-danger"></span> Vencida
                                  </span>
                                </div>
                              </div>

                              <div class="w-full overflow-x-auto">
                                <table class="w-full border-collapse text-left text-[13px]">
                                  <thead>
                                    <tr class="bg-brand-surface border-b border-brand-border">
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-center">#
                                      </th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide">Vencimiento
                                      </th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-right">
                                        Capital</th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-right">
                                        Inter&eacute;s</th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-right">
                                        Cuota</th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-right">
                                        Saldo Final</th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide">Fecha Pago
                                      </th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-center">
                                        Estado</th>
                                      <th class="py-3.5 px-4 font-semibold text-brand-muted tracking-wide text-center">
                                        Acciones</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% cuotas.forEach((c)=> {
                                      const hoy = new Date();
                                      hoy.setHours(0,0,0,0);
                                      const venc = new Date(c.fecha_vencimiento);
                                      const estadoReal = c.estado === 'pagada' ? 'pagada' : (c.estado !== 'pagada' &&
                                      venc < hoy ? 'vencida' : 'pendiente' ); const cuotaFmt=fmt(c.monto_cuota); const
                                        msgWA='Hola ' + prestamo.cliente_nombre
                                        + ', le recordamos que su cuota N\u00b0 ' + c.numero_cuota + ' por $' + cuotaFmt
                                        + ' vence el ' + fmtDate(c.fecha_vencimiento)
                                        + '. Por favor realice su pago a tiempo. \u2014 Financiera Guzmán.' ; const
                                        waUrl=telefonoLimpio ? 'https://wa.me/' + telefonoLimpio + '?text=' +
                                        encodeURIComponent(msgWA) : null; %>
                                        <tr
                                          class="border-b border-brand-border last:border-b-0 transition-colors duration-150 <%= estadoReal === 'pagada' ? 'bg-green-50/50' : estadoReal === 'vencida' ? 'bg-red-50/40' : 'hover:bg-brand-surface' %>">
                                          <td class="py-3 px-4 text-center">
                                            <span
                                              class="inline-flex items-center justify-center w-7 h-7 rounded-full text-[12px] font-bold <%= estadoReal === 'pagada' ? 'bg-brand-success text-white' : estadoReal === 'vencida' ? 'bg-brand-danger text-white' : 'bg-brand-surface2 text-brand-navy' %>">
                                              <%= c.numero_cuota %>
                                            </span>
                                          </td>
                                          <td class="py-3 px-4 text-brand-text font-medium">
                                            <div>
                                              <%= fmtDate(c.fecha_vencimiento) %>
                                            </div>
                                            <% if (c.observacion) { %>
                                              <div
                                                class="text-[10px] text-brand-muted italic mt-0.5 max-w-[160px] truncate"
                                                title="<%= c.observacion %>">
                                                <i class="ri-information-line"></i>
                                                <%= c.observacion %>
                                              </div>
                                              <% } %>
                                          </td>
                                          <td class="py-3 px-4 text-right text-brand-muted">
                                            <%= mon %>&nbsp;<%= fmt(c.capital) %>
                                          </td>
                                          <td class="py-3 px-4 text-right text-brand-muted">
                                            <%= mon %>&nbsp;<%= fmt(c.interes) %>
                                          </td>
                                          <td class="py-3 px-4 text-right font-bold text-brand-blue">
                                            <%= mon %>&nbsp;<%= cuotaFmt %>
                                          </td>
                                          <td class="py-3 px-4 text-right text-brand-text">
                                            <%= mon %>&nbsp;<%= fmt(c.saldo) %>
                                          </td>
                                          <td class="py-3 px-4 text-brand-muted text-[12px]">
                                            <%= c.fecha_pago ? fmtDate(c.fecha_pago) : '\u2014' %>
                                          </td>
                                          <td class="py-3 px-4 text-center">
                                            <% if (estadoReal==='pagada' ) { %>
                                              <span
                                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-[6px] text-[11px] font-semibold bg-brand-success-light text-brand-success border border-brand-success">
                                                <svg width="10" height="10" fill="none" stroke="currentColor"
                                                  viewBox="0 0 24 24">
                                                  <polyline stroke-linecap="round" stroke-linejoin="round"
                                                    stroke-width="3" points="20 6 9 17 4 12" />
                                                </svg>
                                                Pagada
                                              </span>
                                              <% } else if (estadoReal==='vencida' ) { %>
                                                <span
                                                  class="inline-flex items-center gap-1 px-2 py-0.5 rounded-[6px] text-[11px] font-semibold bg-brand-danger-light text-brand-danger border border-brand-danger">
                                                  <svg width="10" height="10" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <circle cx="12" cy="12" r="10" />
                                                    <line x1="12" y1="8" x2="12" y2="12" />
                                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                                  </svg>
                                                  Vencida
                                                </span>
                                                <% } else { %>
                                                  <span
