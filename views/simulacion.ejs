<% if (user.role==='admin' ) { %>
  <%- include('partials/sidebar_admin') %>
    <% } else if (user.role==='asesor' ) { %>
      <%- include('partials/sidebar_asesor') %>
        <% } else { %>
          <%- include('partials/sidebar_cliente') %>
            <% } %>

              <main class="flex-1 h-screen overflow-y-auto bg-brand-bg relative flex flex-col min-w-0">

                <!-- Header -->
                <header
                  class="flex items-center justify-between px-8 py-4 bg-white/92 backdrop-blur-md border-b border-brand-border sticky top-0 z-40">
                  <div>
                    <h1 class="text-[22px] font-bold tracking-tight text-brand-navy">Simulador de Préstamos</h1>
                    <p class="text-[13px] text-brand-muted mt-0.5">Calcula y registra simulaciones hipotecarias —
                      <strong class="font-bold text-brand-text">
                        <%= user.name %>
                      </strong>
                    </p>
                  </div>
                  <div class="flex items-center gap-4">
                    <img src="<%= user.avatar %>" alt="Avatar"
                      class="w-[38px] h-[38px] rounded-full border-2 border-brand-gold object-cover">
                  </div>
                </header>

                <div class="p-8 max-w-[1400px] mx-auto w-full flex-1 flex flex-col gap-6">

                  <!-- Flash Messages -->
                  <% if (typeof success !=='undefined' && success) { %>
                    <div id="flash-success"
                      class="bg-brand-success-light border border-brand-success text-brand-success px-5 py-4 rounded-[12px] flex flex-col gap-1 transition-opacity duration-300 animate-in">
                      <p class="font-bold text-[14px]">¡Éxito!</p>
                      <p class="text-[13px] opacity-90">
                        <%= success %>
                      </p>
                    </div>
                    <% } %>
                      <% if (typeof error !=='undefined' && error) { %>
                        <div id="flash-error"
                          class="bg-brand-danger-light border border-brand-danger text-brand-danger px-5 py-4 rounded-[12px] flex flex-col gap-1 transition-opacity duration-300 animate-in">
                          <p class="font-bold text-[14px]">Error</p>
                          <p class="text-[13px] opacity-90">
                            <%= error %>
                          </p>
                        </div>
                        <% } %>

                          <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-6 items-start animate-in">

                            <!-- LEFT: Formulario -->
                            <div
                              class="bg-white rounded-[20px] shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col overflow-hidden">
                              <!-- Card Header navy -->
                              <div
                                class="bg-gradient-to-br from-brand-navy to-[#122046] px-7 py-6 flex items-center gap-3.5">
                                <div
                                  class="w-[42px] h-[42px] bg-[rgba(212,168,67,.18)] rounded-lg flex items-center justify-center border border-[rgba(212,168,67,.3)]">
                                  <svg width="20" height="20" fill="none" stroke="#D4A843" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                  </svg>
                                </div>
                                <div>
                                  <p class="text-white font-bold text-[16px]">Nueva Simulación</p>
                                  <p class="text-white/50 text-[12px] mt-0.5">Ingresa los parámetros del préstamo</p>
                                </div>
                              </div>

                              <!-- Form -->
                              <div class="p-7 flex flex-col gap-4.5">

                                <!-- Cliente -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">
                                    <span class="flex items-center gap-1.5">
                                      <i class="ri-user-3-line text-[14px]" style="color:var(--c-blue)"></i>
                                      Cliente
                                    </span>
                                  </label>
                                  <select id="sim_cliente"
                                    class="w-full bg-brand-surface border border-brand-border rounded-[10px] px-3.5 py-2.5 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)] sim-select">
                                    <option value="">— Selecciona un cliente —</option>
                                    <% clientes.forEach(c=> { %>
                                      <option value="<%= c.id %>">
                                        <%= c.nombre %>
                                      </option>
                                      <% }) %>
                                  </select>
                                </div>

                                <!-- Inversor -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">
                                    <span class="flex items-center gap-1.5">
                                      <i class="ri-funds-line text-[14px]" style="color:var(--c-gold)"></i>
                                      Inversionista
                                    </span>
                                  </label>
                                  <select id="sim_inversor"
                                    class="w-full bg-brand-surface border border-brand-border rounded-[10px] px-3.5 py-2.5 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)] sim-select">
                                    <option value="">— Selecciona un inversor —</option>
                                    <% inversionistas.forEach(inv=> { %>
                                      <option value="<%= inv.id %>">
                                        <%= inv.nombre %>
                                      </option>
                                      <% }) %>
                                  </select>
                                </div>

                                <!-- Fecha de Simulación -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">
                                    <span class="flex items-center gap-1.5">
                                      <i class="ri-calendar-event-line text-[14px]" style="color:var(--c-blue)"></i>
                                      Fecha de Inicio del Préstamo
                                    </span>
                                  </label>
                                  <div class="relative">
                                    <i
                                      class="ri-calendar-line absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted text-[15px] pointer-events-none"></i>
                                    <input type="date" id="sim_fecha"
                                      class="w-full bg-brand-surface border border-brand-border rounded-[10px] py-2.5 pr-3.5 pl-9 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                  </div>
                                  <p class="text-[11px] text-brand-muted mt-1">Define la fecha base para calcular los
                                    vencimientos del cronograma.</p>
                                </div>

                                <!-- Monto -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">Monto del
                                    Préstamo</label>
                                  <div class="relative">
                                    <span id="sim_moneda_prefix"
                                      class="absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted font-semibold text-[15px]">$</span>
                                    <input type="number" id="sim_monto" placeholder="50,000" min="1000" step="100"
                                      class="w-full bg-brand-surface border border-brand-border rounded-[10px] py-2.5 pr-3.5 pl-8 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                  </div>
                                </div>

                                <!-- Tasas de Interés (Anual y Mensual) -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                  <div>
                                    <label class="block text-[13px] font-semibold text-brand-navy mb-1.5 flex items-center justify-between">
                                      <span>Tasa Anual</span>
                                      <span class="text-[10px] text-brand-muted font-normal">(TEA)</span>
                                    </label>
                                    <div class="relative">
                                      <input type="number" id="sim_interes" placeholder="24.0" min="0.01" max="500"
                                        step="0.01"
                                        class="w-full bg-brand-surface border border-brand-border rounded-[10px] py-2.5 pl-3.5 pr-8 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                      <span
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted font-semibold text-[13px]">%</span>
                                    </div>
                                  </div>
                                  <div>
                                    <label class="block text-[13px] font-semibold text-brand-navy mb-1.5 flex items-center justify-between">
                                      <span>Tasa Mensual</span>
                                      <span class="text-[10px] text-brand-blue font-semibold bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100">TEM</span>
                                    </label>
                                    <div class="relative">
                                      <input type="number" id="sim_interes_mensual" placeholder="2.0" min="0.01" max="100"
                                        step="0.01"
                                        class="w-full bg-brand-surface border border-brand-border rounded-[10px] py-2.5 pl-3.5 pr-8 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                      <span
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted font-semibold text-[13px]">%</span>
                                    </div>
                                  </div>
                                </div>

                                <!-- Plazo -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">Plazo
                                    (Meses)</label>
                                  <input type="number" id="sim_plazo" placeholder="24" min="1" max="360"
                                    class="w-full bg-brand-surface border border-brand-border rounded-[10px] px-3.5 py-2.5 text-[14px] font-medium text-brand-text outline-none transition-all duration-200 hover:border-brand-blue-light focus:border-brand-blue focus:bg-white focus:shadow-[0_0_0_3px_rgba(27,79,216,0.1)]">
                                </div>

                                <!-- Moneda -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">
                                    <span class="flex items-center gap-1.5">
                                      <i class="ri-exchange-dollar-line text-[14px]" style="color:var(--c-gold)"></i>
                                      Moneda
                                    </span>
                                  </label>
                                  <div class="grid grid-cols-2 gap-2.5" id="moneda-group">
                                    <label class="moneda-option cursor-pointer">
                                      <input type="radio" name="moneda" value="$" class="sr-only" checked>
                                      <div
                                        class="moneda-card selected flex items-center justify-center gap-2 p-3 border-2 border-brand-navy bg-brand-navy rounded-lg transition-all duration-200 text-white">
                                        <svg width="15" height="15" fill="none" stroke="currentColor"
                                          viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">$ Dólar</span>
                                      </div>
                                    </label>
                                    <label class="moneda-option cursor-pointer">
                                      <input type="radio" name="moneda" value="S/" class="sr-only">
                                      <div
                                        class="moneda-card flex items-center justify-center gap-2 p-3 border-2 border-brand-border bg-brand-surface2 rounded-lg transition-all duration-200 text-brand-muted">
                                        <svg width="15" height="15" fill="none" stroke="currentColor"
                                          viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">S/ Sol</span>
                                      </div>
                                    </label>
                                  </div>
                                </div>

                                <!-- Forma de Pago / Modalidad de Cálculo -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">
                                    <span class="flex items-center gap-1.5">
                                      <i class="ri-wallet-3-line text-[14px]" style="color:var(--c-blue)"></i>
                                      Forma de Pago / Modalidad
                                    </span>
                                  </label>
                                  <div class="grid grid-cols-1 gap-2" id="modalidad-group">
                                    <!-- Sistema Francés -->
                                    <label class="modalidad-option cursor-pointer block">
                                      <input type="radio" name="modalidad" value="frances" class="sr-only" checked>
                                      <div class="modalidad-card selected p-3 border-2 border-brand-navy bg-brand-surface rounded-xl transition-all duration-200">
                                        <div class="flex items-center justify-between">
                                          <div class="flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
                                            <span class="text-[13px] font-bold text-brand-navy">Sistema Francés (Cuota Fija)</span>
                                          </div>
                                          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-brand-navy text-white">Estándar</span>
                                        </div>
                                        <p class="text-[11px] text-brand-muted mt-1">Cuotas niveladas idénticas mes a mes. Amortización progresiva de capital e intereses sobre saldo.</p>
                                      </div>
                                    </label>

                                    <!-- Interés sobre el Capital (Solo Interés) -->
                                    <label class="modalidad-option cursor-pointer block">
                                      <input type="radio" name="modalidad" value="interes_capital" class="sr-only">
                                      <div class="modalidad-card p-3 border-2 border-brand-border bg-brand-surface2 rounded-xl transition-all duration-200 hover:border-brand-gold">
                                        <div class="flex items-center justify-between">
                                          <div class="flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-brand-gold"></span>
                                            <span class="text-[13px] font-bold text-brand-navy">Interés sobre el Capital</span>
                                          </div>
                                          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-brand-gold-light text-brand-gold-hover border border-brand-gold-light">Solo Interés</span>
                                        </div>
                                        <p class="text-[11px] text-brand-muted mt-1">Cuotas periódicas únicamente de interés sobre el capital; el capital se devuelve al vencimiento o abonos.</p>
                                      </div>
                                    </label>

                                    <!-- Sistema Alemán -->
                                    <label class="modalidad-option cursor-pointer block">
                                      <input type="radio" name="modalidad" value="aleman" class="sr-only">
                                      <div class="modalidad-card p-3 border-2 border-brand-border bg-brand-surface2 rounded-xl transition-all duration-200 hover:border-brand-success">
                                        <div class="flex items-center justify-between">
                                          <div class="flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-brand-success"></span>
                                            <span class="text-[13px] font-bold text-brand-navy">Amortización Constante (Alemán)</span>
                                          </div>
                                          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-brand-success-light text-brand-success border border-brand-success">Decreciente</span>
                                        </div>
                                        <p class="text-[11px] text-brand-muted mt-1">Abono fijo al capital en cada período e intereses sobre el saldo; cuotas decrecientes con el tiempo.</p>
                                      </div>
                                    </label>
                                  </div>
                                </div>

                                <!-- Tipo de Pago -->
                                <div>
                                  <label class="block text-[13px] font-semibold text-brand-navy mb-1.5">Frecuencia de Pago</label>
                                  <div class="grid grid-cols-2 gap-2.5" id="tipo-pago-group">
                                    <label class="tipo-pago-option cursor-pointer">
                                      <input type="radio" name="tipo_pago" value="diario" class="sr-only">
                                      <div
                                        class="tipo-pago-card flex items-center justify-center gap-2 p-3 border-2 border-brand-border bg-brand-surface2 rounded-lg transition-all duration-200 text-brand-muted hover:border-brand-blue-light">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">Diario</span>
                                      </div>
                                    </label>
                                    <label class="tipo-pago-option cursor-pointer">
                                      <input type="radio" name="tipo_pago" value="semanal" class="sr-only">
                                      <div
                                        class="tipo-pago-card flex items-center justify-center gap-2 p-3 border-2 border-brand-border bg-brand-surface2 rounded-lg transition-all duration-200 text-brand-muted hover:border-brand-blue-light">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M8 7V3m8 4V3m-9 8h10M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">Semanal</span>
                                      </div>
                                    </label>
                                    <label class="tipo-pago-option cursor-pointer">
                                      <input type="radio" name="tipo_pago" value="quincenal" class="sr-only">
                                      <div
                                        class="tipo-pago-card flex items-center justify-center gap-2 p-3 border-2 border-brand-border bg-brand-surface2 rounded-lg transition-all duration-200 text-brand-muted hover:border-brand-blue-light">
                                        <svg width="15" height="15" fill="none" stroke="currentColor"
                                          viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">Quincenal</span>
                                      </div>
                                    </label>
                                    <label class="tipo-pago-option cursor-pointer">
                                      <input type="radio" name="tipo_pago" value="mensual" class="sr-only" checked>
                                      <div
                                        class="tipo-pago-card selected flex items-center justify-center gap-2 p-3 border-2 border-brand-navy bg-brand-navy rounded-lg transition-all duration-200 text-white">
                                        <svg width="15" height="15" fill="none" stroke="currentColor"
                                          viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span class="text-[13px] font-semibold">Mensual</span>
                                      </div>
                                    </label>
                                  </div>
                                </div>

                                <!-- Botón Simular -->
                                <button onclick="calcularSimulacion()" id="btn-simular"
                                  class="mt-1 w-full flex items-center justify-center gap-2 px-4 py-3.5 text-[14px] font-semibold rounded-lg transition-all duration-180 bg-gradient-to-br from-brand-blue to-brand-blue-hover text-white shadow-[0_2px_8px_rgba(27,79,216,0.3)] hover:from-brand-blue-light hover:to-brand-blue hover:-translate-y-px hover:shadow-[0_4px_14px_rgba(27,79,216,0.4)]">
                                  <i class="ri-calculator-line text-[17px]"></i>
                                  Calcular Simulación
                                </button>
                              </div>
                            </div>

                            <!-- RIGHT: Resultados -->
                            <div class="flex flex-col gap-5">

                              <!-- Placeholder -->
                              <div id="placeholder-panel"
                                class="bg-white rounded-[20px] shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border py-16 px-8 text-center flex flex-col items-center">
                                <div
                                  class="w-[72px] h-[72px] bg-brand-gold-xlight rounded-full flex items-center justify-center mb-5">
                                  <svg width="32" height="32" fill="none" stroke="var(--c-gold)" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                      d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                  </svg>
                                </div>
                                <p class="text-[16px] font-bold text-brand-text">Aún no has simulado</p>
                                <p class="text-[13px] text-brand-muted mt-1.5 max-w-[280px]">Completa el formulario y
                                  presiona <strong class="font-semibold text-brand-navy">Calcular Simulación</strong>
                                  para ver los resultados aquí.</p>
                              </div>

                              <!-- Resultados (oculto hasta simular) -->
                              <div id="resultados-panel" style="display:none;flex-direction:column;gap:20px;">

                                <!-- Cuota Principal -->
                                <div
                                  class="p-7 bg-brand-navy rounded-[24px] relative overflow-hidden text-white shadow-[0_8px_32px_rgba(10,22,40,0.13)]">
                                  <div
                                    class="absolute -top-[60px] -right-[60px] w-[280px] h-[280px] bg-[radial-gradient(circle,rgba(212,168,67,0.18)_0%,transparent_65%)] rounded-full">
                                  </div>
                                  <div
                                    class="absolute -bottom-[80px] left-[120px] w-[200px] h-[200px] bg-[radial-gradient(circle,rgba(59,114,240,0.25)_0%,transparent_65%)] rounded-full">
                                  </div>

                                  <p
                                    class="text-[11px] font-semibold tracking-[0.05em] uppercase text-brand-gold-light mb-2 relative z-10">
                                    💳 Cuota Estimada</p>
                                  <p id="res_cuota"
                                    class="text-[44px] font-extrabold tracking-tight leading-none relative z-10">$0.00
                                  </p>
                                  <p id="res_tipo_label" class="text-[13px] text-white/50 mt-1 relative z-10">/ mensual
                                  </p>
                                </div>

                                <!-- Métricas Grid -->
                                <div class="grid grid-cols-2 gap-3.5">
                                  <div
                                    class="bg-white rounded-2xl p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col gap-1.5">
                                    <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">
                                      Capital</p>
                                    <p id="res_capital"
                                      class="text-[22px] font-extrabold tracking-tight text-brand-blue leading-tight">
                                      $0.00</p>
                                  </div>
                                  <div
                                    class="bg-white rounded-2xl p-5 shadow-[0_2px_8px_rgba(10,22,40,0.07)] border border-brand-border flex flex-col gap-1.5">
                                    <p class="text-[11px] font-semibold text-brand-muted tracking-wide uppercase">Total
                                      Intereses</p>
                                    <p id="res_intereses"
